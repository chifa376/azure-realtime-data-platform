{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nom de fabrique de données"
		},
		"ls_rest_paris_data": {
			"type": "string"
		},
		"ls_adls_velib": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_ingest_velib')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Collecte paginee des stations Velib dans un dossier distinct par execution. Completude des fichiers a verifier avant traitement.",
				"activities": [
					{
						"name": "get_station_count",
						"description": "Lit le nombre de stations annonce par Paris Data.",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.00:05:00",
							"retry": 3,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "GET",
							"headers": {
								"Accept": "application/json"
							},
							"httpRequestTimeout": "00:01:40",
							"url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/velib-disponibilite-en-temps-reel/records?limit=1"
						}
					},
					{
						"name": "check_station_count",
						"description": "Refuse une source vide ou un volume depassant la plage de pagination retenue.",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "get_station_count",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@and(greater(int(activity('get_station_count').output.total_count), 0), lessOrEquals(int(activity('get_station_count').output.total_count), 9900))",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "fail_invalid_station_count",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "Total de stations nul ou hors de la plage prise en charge : collecte interrompue.",
										"errorCode": "INVALID_STATION_COUNT"
									}
								}
							]
						}
					},
					{
						"name": "for_each_page",
						"description": "Copie les pages de 100 stations successivement.",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "check_station_count",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@range(0, div(add(int(activity('get_station_count').output.total_count), 99), 100))",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "copy_velib_page_to_bronze",
									"description": "Conserve une page JSON avec son enveloppe total_count et results.",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.00:05:00",
										"retry": 3,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "RestSource",
											"httpRequestTimeout": "00:01:40",
											"requestInterval": "00.00:00:01.000",
											"requestMethod": "GET",
											"paginationRules": {
												"supportRFC5988": "false"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings",
												"filePattern": "setOfObjects"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_rest_velib_full",
											"type": "DatasetReference",
											"parameters": {
												"p_offset": {
													"value": "@mul(item(), 100)",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_velib_bronze",
											"type": "DatasetReference",
											"parameters": {
												"p_directory": {
													"value": "@concat('bronze/velib/batch_id=', pipeline().RunId, '/pages')",
													"type": "Expression"
												},
												"p_filename": {
													"value": "@concat('page_', formatNumber(item(), '0000'), '.json')",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"concurrency": 1,
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_rest_velib_full')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_velib_bronze')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_rest_velib_full')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('ls_rest_paris_data')]",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_offset": {
						"type": "Int",
						"defaultValue": 0
					}
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": {
						"value": "@concat('api/explore/v2.1/catalog/datasets/velib-disponibilite-en-temps-reel/records?limit=100&order_by=stationcode&offset=', string(dataset().p_offset))",
						"type": "Expression"
					}
				},
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_adls_velib_bronze')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "[parameters('ls_adls_velib')]",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_directory": {
						"type": "String"
					},
					"p_filename": {
						"type": "String"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_filename",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().p_directory",
							"type": "Expression"
						},
						"fileSystem": "velib-data"
					},
					"encodingName": "UTF-8"
				},
				"schema": {}
			},
			"dependsOn": []
		}
	]
}